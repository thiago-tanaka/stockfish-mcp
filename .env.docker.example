# Template .env for running with Docker. Copy to .env and adjust.
#
#   cp .env.docker.example .env && docker compose run --rm app php artisan key:generate
#
# What differs from the plain .env.example are the hosts: on the compose network, the
# database and the cache answer to the service name, not to 127.0.0.1.

APP_NAME="Stockfish MCP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

# Compose service names, not localhost.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=stockfish_mcp
DB_USERNAME=stockfish
DB_PASSWORD=change-this-password

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

CACHE_STORE=redis
SESSION_DRIVER=database
QUEUE_CONNECTION=database

MCP_REDIRECT_DOMAINS=https://claude.ai,http://localhost

# The engine ships inside the image; this path is the one in there, not on your host.
STOCKFISH_PATH=/usr/local/bin/stockfish
STOCKFISH_THREADS=1
STOCKFISH_HASH_MB=128

# In production, the domain Caddy issues the certificate for.
# SITE_ADDRESS=stockfish.thiagotanaka.dev
