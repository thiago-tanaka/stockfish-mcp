# Caddy obtains and renews the Let's Encrypt certificate by itself, as long as SITE_ADDRESS
# is a public domain pointing here. It is what replaces the platform's one-click SSL.
#
# In development SITE_ADDRESS is :80, and it serves plain HTTP without attempting a
# certificate.
{$SITE_ADDRESS::80} {
	root * /var/www/html/public

	# PHP runs in another container; "app" is the service name on the compose network.
	php_fastcgi app:9000 {
		# A search at high depth runs well past the 60s default.
		read_timeout 300s
	}

	encode zstd gzip
	file_server

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	log {
		output stdout
		format console
	}
}
