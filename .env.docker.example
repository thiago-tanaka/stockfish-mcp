# Modelo de .env para rodar com Docker. Copie para .env e ajuste.
#
#   cp .env.docker.example .env && docker compose run --rm app php artisan key:generate
#
# A diferença para o .env.example comum são os hosts: dentro da rede do compose, o banco e o
# cache atendem pelo nome do serviço, não por 127.0.0.1.

APP_NAME="Stockfish MCP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

# Nomes de serviço do compose, não localhost.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=stockfish_mcp
DB_USERNAME=stockfish
DB_PASSWORD=troque-esta-senha

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

CACHE_STORE=redis
SESSION_DRIVER=database
QUEUE_CONNECTION=database

MCP_REDIRECT_DOMAINS=https://claude.ai,http://localhost

# O motor vem dentro da imagem; este caminho é o de lá dentro, não o do seu host.
STOCKFISH_PATH=/usr/local/bin/stockfish
STOCKFISH_THREADS=1
STOCKFISH_HASH_MB=128

# Em produção, o domínio que o Caddy usa para emitir o certificado.
# SITE_ADDRESS=stockfish.thiagotanaka.dev
