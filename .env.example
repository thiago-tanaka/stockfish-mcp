APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# The MCP server for assistants such as Claude.
# Where an OAuth client may send the user back after consent. Add http://localhost,
# comma separated, to connect from the MCP Inspector or Claude Code while developing.
MCP_REDIRECT_DOMAINS=https://claude.ai

# Stockfish. The path is required; everything else has a working default.
# Download: https://stockfishchess.org/download/ -- the Linux x86-64 build is a single
# universal binary that picks the right code for the CPU it runs on.
STOCKFISH_PATH=/usr/local/bin/stockfish

# Per engine process, not per machine. Every web request and every queue worker holds its
# own engine, so raising these multiplies by the number of them running at once. One thread
# also keeps the search deterministic, which is what makes the position cache sound.
STOCKFISH_THREADS=1
STOCKFISH_HASH_MB=128

# Seconds a queue worker keeps an unused engine alive before releasing its memory.
STOCKFISH_IDLE_TIMEOUT=60

# Seconds one position may take. The engine is asked to stop and the best line so far is
# used, rather than the search being killed.
STOCKFISH_POSITION_TIMEOUT=30

# A whole game is one search per position, so the job's ceiling is generous. Keep
# QUEUE_RETRY_AFTER (config/queue.php) above this, or the queue hands a running game to a
# second worker.
CHESS_ANALYSIS_JOB_TIMEOUT=1800
CHESS_ANALYSIS_RESULT_TTL=86400

# How far apart two evaluations may be before the difference stops meaning anything. Past
# this the game is decided, and comparing raw scores there turns every move of a lost
# position into a blunder.
CHESS_SCORE_BOUND=1500

CHESS_CACHE_TTL=2592000
CHESS_REQUESTS_PER_MINUTE=30
CHESS_REQUESTS_PER_MINUTE_PER_IP=60
