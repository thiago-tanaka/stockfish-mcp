# Caddy obtém e renova o certificado Let's Encrypt sozinho, desde que SITE_ADDRESS seja um
# domínio público que aponte para cá. É o que substitui o SSL de um clique do Forge.
#
# Em desenvolvimento SITE_ADDRESS é :80 e ele serve HTTP puro, sem tentar certificado.
{$SITE_ADDRESS::80} {
	root * /var/www/html/public

	# O PHP roda noutro container; "app" é o nome do serviço na rede do compose.
	php_fastcgi app:9000 {
		# Uma análise em profundidade alta passa muito do padrão de 60s.
		read_timeout 300s
	}

	encode zstd gzip
	file_server

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	log {
		output stdout
		format console
	}
}
